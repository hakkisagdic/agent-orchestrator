#!/usr/bin/env python3
"""Clone-local entry point for the watchdog.

Kept because installed launchd jobs name this path; changing it would silently
stop watching the projects that already depend on it.
"""
import os
import sys

sys.path.insert(0, os.path.join(
    os.path.dirname(os.path.dirname(os.path.abspath(__file__))), "src"))
from ao.watchdog import main  # noqa: E402

if __name__ == "__main__":
    sys.exit(main())
